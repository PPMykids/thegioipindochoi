<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>TheGioiPinDoChoi</title>
  <meta name="description" content="Đồ chơi tư duy và pin cho thiết bị điện tử.">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="./">TheGioiPinDoChoi</a>
      <a class="contact-link" href="https://zalo.me/0964349029">NHẮN TIN ZALO</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">CỬA HÀNG TRỰC TUYẾN</p>
        <h1>TheGioiPinDoChoi</h1>
        <p class="hero-subtitle">ĐỒ CHƠI TƯ DUY • PIN CHO THIẾT BỊ ĐIỆN TỬ</p>
        <p>Khám phá sản phẩm phù hợp cho gia đình và thiết bị của bạn.</p>
        <a class="button button-orange" href="#san-pham">XEM SẢN PHẨM</a>
      </div>
    </section>

    <section class="container products-section" id="san-pham">
      <div class="section-heading">
        <div>
          <p class="eyebrow">DANH MỤC CỬA HÀNG</p>
          <h2>Sản phẩm của chúng tôi</h2>
        </div>
      </div>

      <div class="category-block">
        <h3>Đồ chơi tư duy</h3>
        <div class="product-grid" id="toyProducts"></div>
      </div>

      <div class="category-block">
        <h3>Pin cho thiết bị điện tử</h3>
        <div class="product-grid" id="batteryProducts"></div>
      </div>

      <p id="productStatus" class="status-message">Đang tải sản phẩm...</p>
    </section>

    <section class="contact-section">
      <div class="container contact-inner">
        <div>
          <p class="eyebrow">CHÚNG TÔI LUÔN SẴN SÀNG HỖ TRỢ</p>
          <h2>Bạn cần tư vấn sản phẩm?</h2>
          <p>Liên hệ cửa hàng hoặc gửi thông tin để chúng tôi gọi lại.</p>
        </div>
        <div class="contact-actions">
          <a class="button button-blue" href="https://zalo.me/0964349029">NHẮN TIN ZALO</a>
          <a class="button button-outline" id="consultButton" href="#">ĐĂNG KÝ TƯ VẤN</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <strong>TheGioiPinDoChoi</strong>
      <p>ĐỒ CHƠI TƯ DUY • PIN CHO THIẾT BỊ ĐIỆN TỬ</p>
    </div>
  </footer>

  <script src="script.js"></script>
</body>
</html>
