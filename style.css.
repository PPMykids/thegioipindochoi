.product-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8px;
  padding: 14px;
}

.product-code {
  color: var(--muted);
  font-size: 11px;
}

.product-name {
  margin: 0;
  color: var(--blue);
  font-size: 15px;
  line-height: 1.4;
}

.product-description {
  color: var(--muted);
  font-size: 12px;
}

.product-prices {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: auto;
}

.product-price {
  color: var(--orange-dark);
  font-size: 20px;
  font-weight: 800;
}

.product-old-price {
  color: #8b98a3;
  font-size: 12px;
  text-decoration: line-through;
}

.buy-button {
  display: block;
  margin-top: 8px;
  padding: 11px 8px;
  color: var(--white);
  background: #ee4d2d;
  border-radius: 8px;
  text-align: center;
  font-size: 12px;
  font-weight: 800;
}

.status-message {
  color: var(--muted);
  text-align: center;
}

.contact-section {
  padding: 38px 0;
  background: #fff3e5;
}

.contact-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.site-footer {
  padding: 25px 0;
  color: var(--white);
  background: var(--blue);
  text-align: center;
}

.site-footer p {
  margin: 4px 0 0;
  color: #d7e6ef;
  font-size: 12px;
}

@media (max-width: 850px) {
  .product-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .hero {
    padding: 48px 0;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .product-info {
    padding: 10px;
  }

  .product-name {
    font-size: 13px;
  }

  .product-price {
    font-size: 17px;
  }

  .contact-inner {
    align-items: flex-start;
    flex-direction: column;
  }

  .header-inner {
    align-items: flex-start;
    flex-direction: column;
  }
}
